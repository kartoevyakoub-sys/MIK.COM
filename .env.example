# Supabase (not secret but project-specific; set in Vercel env)
# SUPABASE_URL нужен api-функциям (api/upload.js, api/delete.js) — это URL
# твоего Supabase-проекта без слеша на конце:
SUPABASE_URL=https://zwhwbojsmxngdacycnxj.supabase.co
# anon-ключ публичный (лежит в config.js) и приходит от клиента — в env не обязателен.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Blob — файлы хранятся в Blob через свой домен (api/upload.js).
# Задайте ЛЮБОЙ из вариантов:
#   1) классический токен (Vercel Dashboard -> Storage -> Blob store):
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx
#   2) либо OIDC-хранилище без токена (store id из Dashboard -> Storage):
BLOB_STORE_ID=blob_xxxx